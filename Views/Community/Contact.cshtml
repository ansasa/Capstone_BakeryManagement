@model ContactMessage
<h1>Contact us</h1><p>Questions about a cake, an order or a celebration? Send us a message.</p>@if(ViewBag.Success!=null){<p class="success">@ViewBag.Success</p>}<form asp-action="Contact" method="post" class="form-card"><label>Name</label><input asp-for="Name"/><span asp-validation-for="Name"></span><label>Email</label><input asp-for="Email"/><span asp-validation-for="Email"></span><label>Message</label><textarea asp-for="Message"></textarea><span asp-validation-for="Message"></span><button class="btn">Send message</button></form><div class="contact-note"><p>📍 123 Baker Street, Your City</p><p>☎ +91 98765 43210</p><p>✉ hello@sweetcrumbs.example</p><small>Replace these sample contact details with your real business information.</small></div>
