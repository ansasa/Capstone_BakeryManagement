@model IEnumerable<Review>
<h1>Customer reviews</h1><div class="reviews">@foreach(var r in Model){<article class="review"><div class="stars">@for(int i=0;i<r.Rating;i++){<text>★</text>}</div><strong>@r.CustomerName</strong><p>@r.Comment</p><small>@r.CreatedAt.ToLocalTime().ToString("d")</small></article>}</div><h2>Leave a review</h2><form asp-action="AddReview" method="post" class="form-card"><label>Your name</label><input name="CustomerName" required maxlength="80"/><label>Rating</label><select name="Rating"><option value="5">5 - Excellent</option><option value="4">4 - Very good</option><option value="3">3 - Good</option><option value="2">2 - Fair</option><option value="1">1 - Poor</option></select><label>Your review</label><textarea name="Comment" required maxlength="1000"></textarea><button class="btn">Submit review</button></form>
