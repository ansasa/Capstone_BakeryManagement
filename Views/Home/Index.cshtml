@model IEnumerable<Product>
<section class="hero"><div><p class="eyebrow">BAKED FRESH EVERY DAY</p><h1>A little sweetness<br/>for every moment.</h1><p>Handcrafted cakes, flaky pastries and warm bread made with care.</p><a class="btn" href="#menu">Explore the menu</a></div><div class="hero-art">🎂<span>🥐</span></div></section>
<section id="menu"><div class="section-head"><div><p class="eyebrow">OUR FAVOURITES</p><h2>Made fresh for you</h2></div><a asp-controller="Cart" asp-action="Index">View cart →</a></div><div class="products">@foreach(var p in Model){<article class="product"><img src="@(string.IsNullOrWhiteSpace(p.ImageUrl)? "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=600":p.ImageUrl)" alt="@p.Name"/><div class="product-body"><small>@p.Category</small><h3>@p.Name</h3><p>@p.Description</p><div class="product-bottom"><strong>₹@p.Price.ToString("0.00")</strong><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn small">Add to cart +</button></form></div></div></article>}</div></section>
