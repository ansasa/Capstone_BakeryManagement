@model Order
<div class="receipt"><div class="no-print"><a asp-controller="Home" asp-action="Index">← Home</a><button class="btn" onclick="window.print()">Print order</button></div><h1>Sweet Crumbs Bakery</h1><p>ORDER RECEIPT</p><hr/><p><strong>Order #:</strong> @Model.Id</p><p><strong>Date:</strong> @Model.CreatedAt.ToLocalTime().ToString("f")</p><p><strong>Customer:</strong> @Model.CustomerName</p><p><strong>Email:</strong> @Model.Email</p><p><strong>Delivery address:</strong> @Model.DeliveryAddress</p><table><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Amount</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.ProductName</td><td>@i.Quantity</td><td>₹@i.UnitPrice</td><td>₹@(i.UnitPrice*i.Quantity)</td></tr>}</tbody></table><h2 class="total">Total: ₹@Model.Total.ToString("0.00")</h2><p>Payment status: @Model.PaymentStatus</p><p>Thank you for shopping with us!</p></div>
