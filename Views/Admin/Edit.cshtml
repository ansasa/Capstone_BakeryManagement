@model Product
<h1>@(Model.Id==0?"Add bakery item":"Edit bakery item")</h1><form asp-action="Save" method="post" class="form-card"><input asp-for="Id" type="hidden"/><label>Name</label><input asp-for="Name"/><span asp-validation-for="Name"></span><label>Description</label><textarea asp-for="Description"></textarea><label>Category</label><input asp-for="Category"/><label>Price (INR)</label><input asp-for="Price" type="number" step=".01"/><label>Image URL</label><input asp-for="ImageUrl"/><label><input asp-for="IsAvailable"/> Available for sale</label><button class="btn">Save item</button></form>
