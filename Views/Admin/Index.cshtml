@model IEnumerable<Product>
<div class="section-head"><div><p class="eyebrow">ADMIN</p><h1>Manage bakery items</h1></div><a class="btn" asp-action="Create">+ Add item</a></div><p><a asp-action="Orders">View orders →</a></p><table><thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Available</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category</td><td>₹@p.Price</td><td>@p.IsAvailable</td><td><a asp-action="Edit" asp-route-id="@p.Id">Edit</a> <form class="inline" asp-action="Delete" asp-route-id="@p.Id" method="post"><button class="link-button">Delete</button></form></td></tr>}</tbody></table>
